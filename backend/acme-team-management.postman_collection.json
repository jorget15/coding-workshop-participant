  },
  "variable": [
    { "key": "individuals_url", "value": "http://37gf95jb5bgo5gr5vdhersdbzxe9deud.lambda-url.us-east-1.localhost.localstack.cloud:4566", "type": "string" },
    { "key": "teams_url",       "value": "http://w0qix3eg7iwxeah0cceco5w5iblvjmbh.lambda-url.us-east-1.localhost.localstack.cloud:4566", "type": "string" },
    { "key": "achievements_url","value": "http://amza32q7wvradxxgln6tkbw3bckhcmh7.lambda-url.us-east-1.localhost.localstack.cloud:4566", "type": "string" },
    { "key": "metadata_url",    "value": "http://iw60i0k4agvjvrzujxldb3oun9zcezd8.lambda-url.us-east-1.localhost.localstack.cloud:4566", "type": "string" },
